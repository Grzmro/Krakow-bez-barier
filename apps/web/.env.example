# Unset: the real API (needs DATABASE_URL). "true" answers from the openapi.yaml examples instead (tests, demo).
NEXT_PUBLIC_API_MOCK=
# MapLibre style URL (OpenFreeMap needs no key). Default: https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=
# ORS_API_KEY (routes) and DATABASE_URL live in the root .env; next.config.ts loads it. Without the key, routes
# come from recorded openrouteservice answers (Dworzec Główny → Rynek Główny only).

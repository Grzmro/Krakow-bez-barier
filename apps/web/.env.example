# Answer API calls from the openapi.yaml examples instead of the real endpoints ("false" to disable).
NEXT_PUBLIC_API_MOCK=true
# MapLibre style URL (OpenFreeMap needs no key). Default: https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=
# Server only: openrouteservice key for POST /api/v1/routes (https://openrouteservice.org/dev/#/signup).
# Without it the route screen says routing is unavailable; the rest of the app works.
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org

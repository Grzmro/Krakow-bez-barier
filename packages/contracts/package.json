{
  "name": "@krakow-bez-barier/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI 3.1 contract (spec-first) with generated types and typed client.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["openapi.yaml", "src"],
  "scripts": {
    "contracts:generate": "openapi-typescript openapi.yaml -o src/generated/schema.d.ts && node scripts/generate-examples.mjs",
    "postinstall": "npm run contracts:generate",
    "lint": "redocly lint openapi.yaml --max-problems 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}

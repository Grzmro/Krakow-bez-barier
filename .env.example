# Copy to .env (gitignored) and adjust.
DATABASE_URL=postgres://kbb:kbb@localhost:5432/kbb
# The web UI uses the real API by default (needs DATABASE_URL); true = example data from openapi.yaml. Build-time.
# NEXT_PUBLIC_API_MOCK=true
# Moderator sign-in for /api/v1/moderation/*: comma-separated name:token pairs, tokens of 16+ characters.
# Leave empty to keep moderation closed.
MODERATOR_TOKENS=
# Demo moderator account for the jury (16+ characters): marked in the panel, its decisions are undone after 30 min.
# The jury enters it with a button on /moderator (a server-signed session; this token stays secret). Empty disables both.
MODERATOR_DEMO_TOKEN=
# openrouteservice API key, server-side only (https://openrouteservice.org/dev/#/signup). The web app reads this
# file too (next.config.ts). Without the key, routes come from recorded answers (Dworzec Główny → Rynek only).
ORS_API_KEY=
# openrouteservice base URL (default https://api.openrouteservice.org; a self-hosted instance works too)
# ORS_BASE_URL=
# Transit departures on the place card (GET /transit/departures): live (default), recorded (tests, e2e) or off.
# A production build serves none until the ZTP licence is confirmed (ZTP_SOURCE.licenseConfirmed).
# TRANSIT_FEED=live
# ZTP GTFS and GTFS-Realtime files (default https://gtfs.ztp.krakow.pl)
# ZTP_GTFS_BASE_URL=
# Local Postgres from docker-compose.yml (defaults shown; must match DATABASE_URL)
# POSTGRES_USER=kbb
# POSTGRES_PASSWORD=kbb
# POSTGRES_DB=kbb
# POSTGRES_PORT=5432
# Ingest (apps/ingest) — optional overrides
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# INGEST_CACHE_DIR=.ingest-cache
# INGEST_USER_AGENT=
# INGEST_FETCH_ATTEMPTS=3
# INGEST_RETRY_BASE_MS=1000
# Named area of the city config to ingest instead of the whole city (same as `--area`), e.g. demo
# INGEST_AREA=
# Records written in parallel (each one DB connection)
# INGEST_CONCURRENCY=16
# Demo/test switch, never set in production: comma-separated source ids that behave as failed
# (ingest skips the fetch and marks them outage; GET /sources reports them as outage). Last data stays.
# SIMULATE_SOURCE_OUTAGE=msip-toilets
# In production the switch is ignored unless ALLOW_SIMULATED_OUTAGE=true (live demo only).

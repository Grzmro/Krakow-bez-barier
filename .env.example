# Copy to .env (gitignored) and adjust.
DATABASE_URL=postgres://kbb:kbb@localhost:5432/kbb
# openrouteservice API key, server-side only (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
# Local Postgres from docker-compose.yml (defaults shown; must match DATABASE_URL)
# POSTGRES_USER=kbb
# POSTGRES_PASSWORD=kbb
# POSTGRES_DB=kbb
# POSTGRES_PORT=5432
# Ingest (apps/ingest) — optional overrides
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# INGEST_CACHE_DIR=.ingest-cache
# INGEST_USER_AGENT=
